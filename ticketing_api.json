{
	"info": {
		"name": "Ticketing System API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/api/v1",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "event_id",
			"value": "b7adbfd2-4b14-44e9-811b-aaa5103d58f8",
			"type": "string"
		},
		{
			"key": "ticket_type_id_1",
			"value": "e2af9d90-9c73-411c-b7d7-f4643fb9418a",
			"type": "string"
		},
		{
			"key": "ticket_type_id_2",
			"value": "66783f48-9d70-48df-8a19-c63aafe81ea2",
			"type": "string"
		},
		{
			"key": "order_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin_user\",\n    \"email\": \"admin@example.com\",\n    \"password\": \"admin123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "http://localhost:8080/api/v1/auth/register"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"admin\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "http://localhost:8080/api/v1/auth/login"
					}
				}
			]
		},
		{
			"name": "Events",
			"item": [
				{
					"name": "Create Event (with Tickets)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Lễ hội âm nhạc 2026\",\n  \"slug\": \"music-festival-2026\",\n  \"location\": \"Sân vận động Mỹ Đình\",\n  \"banner_url\": \"https://example.com/banner.jpg\",\n  \"start_time\": \"2026-06-15T19:00:00Z\",\n  \"end_time\": \"2026-06-16T02:00:00Z\",\n  \"ticket_types\": [\n    {\n      \"name\": \"VIP Ticket\",\n      \"price\": 2000000,\n      \"initial_quantity\": 100\n    },\n    {\n      \"name\": \"Standard Ticket\",\n      \"price\": 500000,\n      \"initial_quantity\": 1000\n    },\n    {\n      \"name\": \"Early Bird\",\n      \"price\": 300000,\n      \"initial_quantity\": 200\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "http://localhost:8080/api/v1/events/"
					}
				},
				{
					"name": "Get Event by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8080/api/v1/events/{{event_id}}"
					}
				},
				{
					"name": "Get Event by Slug",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8080/api/v1/events/slug/rock-concert-2026"
					}
				},
				{
					"name": "List Events",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8080/api/v1/events?limit=10&offset=0"
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Place Order",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    {\n      \"ticket_type_id\": \"{{ticket_type_id_1}}\",\n      \"quantity\": 2,\n      \"unit_price\": \"2000000\"\n    },\n    {\n      \"ticket_type_id\": \"{{ticket_type_id_2}}\",\n      \"quantity\": 5,\n      \"unit_price\": \"500000\"\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "http://localhost:8080/api/v1/orders"
					}
				},
				{
					"name": "Get User Orders",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": "http://localhost:8080/api/v1/orders?limit=10&offset=0"
					}
				},
				{
					"name": "Get Order by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": "http://localhost:8080/api/v1/orders/{{order_id}}"
					}
				},
				{
					"name": "Cancel Order",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": "http://localhost:8080/api/v1/orders/{{order_id}}/cancel"
					}
				}
			]
		}
	]
}